# Скопируй в .env и поправь значения (.env в .gitignore — секреты не коммитим).
# Для локального демо подойдут значения по умолчанию.

POSTGRES_USER=sirius
POSTGRES_PASSWORD=change-me-sirius

KC_DB_USER=keycloak
KC_DB_PASSWORD=change-me-kc
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin

MINIO_USER=sirius
MINIO_PASSWORD=change-me-minio

MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=change-me-mlflow

# control-plane как CI: HMAC-секрет вебхука Gitea + токен Gitea API (для commit-status).
# GITEA_TOKEN пустой → вебхук проверяет подпись и гоняет гейт, но статус обратно не ставит.
CI_WEBHOOK_SECRET=change-me-ci-webhook
GITEA_TOKEN=

# Сид (hex) для Ed25519-ключа подписи моделей (SUP-04). Пусто → демо-дефолт; в проде — HSM/KMS.
SIGNING_SEED=

REDIS_PASSWORD=change-me-redis

GRAFANA_PASSWORD=change-me-grafana

# Токен сервиса serving для отчёта о рантайм-детектах в control-plane.
# Для демо подойдёт dev-токен (работает при DEV_AUTH=1); в проде — сервис-аккаунт Keycloak.
SERVING_SERVICE_TOKEN=dev:serving:MLSecOps

# 1 = разрешить локальные dev-токены (Bearer dev:<user>:<role>) БЕЗ Keycloak.
# В реальном демо держать 0 — authN идёт через Keycloak (OIDC).
DEV_AUTH=0
