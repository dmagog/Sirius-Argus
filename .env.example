# ШАБЛОН окружения. Секреты тут ПУСТЫЕ и НЕ коммитятся (в docker-compose дефолтов секретов нет).
# Сгенерируй рабочий .env командой:  make secrets  (заполнит пустые значения случайными, .env в .gitignore).
# Прод — .env.production + секрет-стор/KMS. Не-секретные значения (юзеры/порты/флаги) можно править тут.

POSTGRES_USER=sirius
POSTGRES_PASSWORD=

KC_DB_USER=keycloak
KC_DB_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

MINIO_USER=sirius
MINIO_PASSWORD=

MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=

# MLflow basic-auth: реестр под логином (control-plane ходит под этим же юзером).
MLFLOW_AUTH_USER=sirius-cp
MLFLOW_AUTH_PASSWORD=
# MinIO scoped-юзер для MLflow-артефактов (политика только на s3://mlflow, не root).
MLFLOW_S3_USER=mlflow-svc
MLFLOW_S3_PASSWORD=
# MinIO scoped-юзер для карантин-стора control-plane (только s3://sirius-quarantine, не root) — AUD-11.
CP_S3_USER=cp-svc
CP_S3_PASSWORD=

# control-plane как CI: HMAC-секрет вебхука Gitea + токен Gitea API (для commit-status).
# GITEA_TOKEN пустой → вебхук проверяет подпись и гоняет гейт, но статус обратно не ставит.
CI_WEBHOOK_SECRET=
GITEA_TOKEN=
# Admin-юзер Gitea — создаётся автоматически сервисом gitea-init (без визарда установки).
GITEA_ADMIN_USER=sirius
GITEA_ADMIN_PASSWORD=

# Сид (hex) для Ed25519-ключа подписи моделей (SUP-04). Пусто → демо-дефолт; в проде — HSM/KMS.
SIGNING_SEED=

# 1 = включить pip-audit/OSV для скана зависимостей (нужен egress; для CI). 0 = офлайн-база CVE.
DEPS_AUDIT_ONLINE=0

# Потолок тела запроса (байты, AUD-20): 2 ГиБ — реальные модели проходят, но не безлимит.
# Для сценария DOS-02 (малый лимит 25 МиБ) используйте `make up-test` (docker-compose.test.yml).
MAX_UPLOAD_BYTES=2147483648

REDIS_PASSWORD=

GRAFANA_PASSWORD=

# OIDC-секреты клиентов Keycloak для единого входа в ops-консоли (клиенты создаёт keycloak-init).
GRAFANA_OIDC_SECRET=
GITEA_OIDC_SECRET=
MINIO_OIDC_SECRET=

# Сервис-токен serving↔control-plane (pre-shared, constant-time; обе стороны читают одно значение).
SIRIUS_SERVICE_TOKEN=

# Dev-root-токен Vault (dev-режим VAULT_DEV_ROOT_TOKEN_ID; vault-init ходит этим же токеном — должны совпадать).
VAULT_ROOT_TOKEN=

# 1 = разрешить локальные dev-токены (Bearer dev:<user>:<role>) БЕЗ Keycloak.
# В реальном демо держать 0 — authN идёт через Keycloak (OIDC).
DEV_AUTH=0
