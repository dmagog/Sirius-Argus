# Единственная точка входа для людей (ADR-0005).
# /auth/* -> Keycloak (OIDC-логин + admin-консоль), всё остальное -> control-plane.
# Префикс /auth НЕ срезаем (handle, не handle_path): Keycloak сам под KC_HTTP_RELATIVE_PATH=/auth,
# поэтому его собственные редиректы (/auth/admin, /auth/realms/...) остаются валидными за прокси.
:80 {
	# AUD-03: identity-заголовки от клиента не доверяем (их ставит только oauth2-proxy в проде)
	request_header -X-Auth-Request-User
	request_header -X-Auth-Request-Email

	# периметр: потолок тела — экстремальный оверсайз режется на входе (413), до control-plane
	# (defense-in-depth). Выше app-лимита MAX_UPLOAD_BYTES (2 ГиБ), чтобы реальные модели проходили,
	# а связывающим guard'ом был app-уровень (он же пишет Finding/аудит).
	request_body {
		max_size 3GB
	}
	handle /auth/* {
		reverse_proxy keycloak:8080
	}
	reverse_proxy control-plane:8000
}
