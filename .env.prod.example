# .env.prod — конфигурация ПУБЛИЧНОГО стенда. НЕ КОММИТИТЬ (в .gitignore).
# Обычно генерится scripts/deploy_netangels.sh; этот файл — справка по ключам.

# --- периметр / домен ---
PUBLIC_HOST=sirius.example.ru          # домен, на который указывает A-запись сервера
DEMO_USER=demo                         # логин HTTP Basic Auth периметра (для жюри)
DEMO_PASS_HASH=                         # bcrypt-хэш пароля: docker run --rm caddy:2-alpine caddy hash-password --plaintext '...'

# --- режим ---
DEV_AUTH=0                             # 0 на публичном контуре (1 = обход authN на /api, только для засева)

# --- секреты инфраструктуры (ротировать; не оставлять change-me) ---
POSTGRES_USER=sirius
POSTGRES_PASSWORD=
KC_DB_USER=keycloak
KC_DB_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
MINIO_USER=sirius
MINIO_PASSWORD=
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=
REDIS_PASSWORD=
CI_WEBHOOK_SECRET=
SIGNING_SEED=
VAULT_ROOT_TOKEN=
SIRIUS_SERVICE_TOKEN=                  # общий сервис-токен serving↔control-plane (любой стойкий, не дефолт)

# OIDC-секреты ops-консолей: для core не критичны (Grafana/Gitea/MinIO-консоль наружу не публикуются)
GRAFANA_OIDC_SECRET=grafana-oidc-dev
GITEA_OIDC_SECRET=gitea-oidc-dev
MINIO_OIDC_SECRET=minio-oidc-dev
