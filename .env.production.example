# .env.production — секреты БОЕВОГО контура. НЕ КОММИТИТЬ. Все значения — из секрет-стора/KMS.
# Перед go-live: ни одной пустой/дефолтной строки (см. чек-лист в docs/runbooks/deploy-production.md).

# --- домен ---
PUBLIC_HOST=sirius.example.org

# --- режим ---
DEV_AUTH=0                              # в проде всегда 0

# --- hardening control-plane ---
MAX_UPLOAD_BYTES=2147483648           # AUD-20: потолок тела запроса (байты); 2 ГиБ — реальные модели проходят, но не безлимит
# AUD-05: проверка audience/issuer OIDC-токена. Задавать ПОСЛЕ сверки, что токены клиента
# control-plane реально несут эти aud/iss (иначе все токены будут отвергнуты). Пусто = проверка выкл.
OIDC_AUDIENCE=                         # = client_id control-plane (например sirius)
OIDC_ISSUER=                           # = https://<PUBLIC_HOST>/auth/realms/sirius

# --- Keycloak (prod) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=                # стойкий; демо-персоны в realm удалить

# --- БД ---
POSTGRES_USER=sirius
POSTGRES_PASSWORD=
KC_DB_USER=keycloak
KC_DB_PASSWORD=
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=
MLFLOW_AUTH_USER=sirius-cp              # basic-auth реестра: control-plane↔MLflow
MLFLOW_AUTH_PASSWORD=                   # стойкий (не дефолт); тот же для сервера и клиента
MLFLOW_S3_USER=mlflow-svc               # MinIO scoped-юзер для артефактов (политика s3://mlflow)
MLFLOW_S3_PASSWORD=                     # стойкий (не дефолт)
CP_S3_USER=cp-svc                       # MinIO scoped-юзер control-plane (только sirius-quarantine), AUD-11
CP_S3_PASSWORD=                         # стойкий (не дефолт)

# --- объектный стор / кэш ---
MINIO_USER=
MINIO_PASSWORD=
REDIS_PASSWORD=

# --- подпись / CI / сервис-аккаунт ---
SIGNING_SEED=                          # ПОСТОЯННЫЙ из стора (смена ломает верификацию подписей)
CI_WEBHOOK_SECRET=
SIRIUS_SERVICE_TOKEN=                  # serving↔control-plane, стойкий (не дефолт)

# --- OIDC ops-консолей ---
GRAFANA_PASSWORD=                      # AUD-24: стойкий admin-пароль Grafana (не admin/admin)
GRAFANA_OIDC_SECRET=
GITEA_OIDC_SECRET=
MINIO_OIDC_SECRET=

# --- OIDC-вход в UI (oauth2-proxy ↔ Keycloak-клиент sirius-ui) ---
UI_OIDC_CLIENT_ID=sirius-ui
UI_OIDC_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=            # 32 байта: `openssl rand -base64 32`

# --- Vault (AppRole для control-plane; выдаётся vault-init-prod.sh после unseal) ---
VAULT_ROLE_ID=
VAULT_SECRET_ID=
