# .env.production — секреты БОЕВОГО контура. НЕ КОММИТИТЬ. Все значения — из секрет-стора/KMS.
# Перед go-live: ни одной пустой/дефолтной строки (см. чек-лист в docs/runbooks/deploy-production.md).

# --- домен ---
PUBLIC_HOST=sirius.example.org

# --- режим ---
DEV_AUTH=0                              # в проде всегда 0

# --- Keycloak (prod) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=                # стойкий; демо-персоны в realm удалить

# --- БД ---
POSTGRES_USER=sirius
POSTGRES_PASSWORD=
KC_DB_USER=keycloak
KC_DB_PASSWORD=
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=

# --- объектный стор / кэш ---
MINIO_USER=
MINIO_PASSWORD=
REDIS_PASSWORD=

# --- подпись / CI / сервис-аккаунт ---
SIGNING_SEED=                          # ПОСТОЯННЫЙ из стора (смена ломает верификацию подписей)
CI_WEBHOOK_SECRET=
SIRIUS_SERVICE_TOKEN=                  # serving↔control-plane, стойкий (не дефолт)

# --- OIDC ops-консолей ---
GRAFANA_OIDC_SECRET=
GITEA_OIDC_SECRET=
MINIO_OIDC_SECRET=

# --- OIDC-вход в UI (oauth2-proxy ↔ Keycloak-клиент sirius-ui) ---
UI_OIDC_CLIENT_ID=sirius-ui
UI_OIDC_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=            # 32 байта: `openssl rand -base64 32`

# --- Vault (AppRole для control-plane; выдаётся vault-init-prod.sh после unseal) ---
VAULT_ROLE_ID=
VAULT_SECRET_ID=
